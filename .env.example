# ==============================================================================
# TalentPulse Environment Configuration Template
# Copy this file to .env or configure your environment variables accordingly.
# NEVER commit sensitive production credentials or production JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Microservice Networking & Service Discovery
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka/
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
JOB_SERVICE_PORT=8082
APPLICATION_SERVICE_PORT=8083

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentpulse
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# JWT Security Configuration
# Must be a 256-bit (32+ bytes) Base64-encoded secret key shared across services.
# Generate a strong key using: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Token expiration time in milliseconds (Default: 24 Hours = 86400000 ms)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
