              { "key": "Authorization", "value": "Bearer {{jobSeekerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SELECTED\",\n  \"notes\": \"Self-selection attempt\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "4.9 Attempt View Another Candidate's Application (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/applications/9999",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["applications", "9999"]
            }
          }
        },
        {
          "name": "4.10 Attempt Access Another Recruiter's Applications (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jobSeekerToken}}" }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/applications/recruiter",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["applications", "recruiter"]
            }
          }
        },
        {
          "name": "4.11 Attempt Update Another Recruiter's Applicant Status (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jobSeekerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "4.12 Request Invalid Application ID (404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/applications/999999",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["applications", "999999"]
            }
          }
        }
      ]
    },
